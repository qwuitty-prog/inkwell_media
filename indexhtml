<!-- ═══════════════════════════════════════════
     WAVE MARQUEE TEXT SECTION
     
     HOW IT WORKS:
     • SVG with a sinusoidal (wave) path defined using cubic bezier curves
     • Text is placed on the path using <textPath>
     • The entire <g> group is duplicated (copy1 + copy2)
       — copy1 goes from 0% to -50%, copy2 follows seamlessly
     • The @keyframes wave-scroll translates by -50% 
       so copy2 fills in exactly when copy1 exits = seamless loop
     • viewBox height (80) controls wave amplitude room
═══════════════════════════════════════════ -->
<div class="wave-marquee" aria-hidden="true">
  <svg viewBox="0 0 2400 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
    <defs>
      <!-- 
        Wave path: starts left of view, undulates up and down,
        extends well beyond the right edge (doubled for seamless loop)
        M = start point
        C = cubic bezier curves creating the wave shape
      -->
      <path id="wavePath"
        d="
          M-200,50
          C0,20 200,65 400,40
          C600,15 800,60 1000,38
          C1200,18 1400,62 1600,40
          C1800,18 2000,60 2200,38
          C2400,18 2600,62 2800,40
          C3000,18 3200,60 3400,38
          C3600,18 3800,62 4000,40
          C4200,18 4400,60 4600,38
        "
      />
    </defs>

    <!-- 
      We need TWO identical groups side by side.
      Group total width = 2400px (one full SVG width).
      Animation moves by -50% of the combined width = -2400px.
      When group reaches -2400, it appears to loop because
      the second copy has been filling in from the right.
    -->
    <g class="wave-group">

      <!-- Copy 1: starts at x=0 -->
      <text>
        <textPath href="#wavePath" startOffset="0%">
          4× Avg ROAS &nbsp;✦&nbsp; 1,500+ Ads Produced &nbsp;✦&nbsp; 100+ Brands &nbsp;✦&nbsp; Short-Form UGC &nbsp;✦&nbsp; CGI Product Videos &nbsp;✦&nbsp; Campaign Films &nbsp;✦&nbsp; 48h Turnaround &nbsp;✦&nbsp; D2C Specialists &nbsp;✦&nbsp;
        </textPath>
      </text>

      <!--
        Copy 2: offset by exactly the SVG viewBox width (2400).
        Placed using a transform so it starts exactly where copy1 ends.
        This is the "seamless duplicate" that appears to continue the loop.
      -->
      <text transform="translate(2400, 0)">
        <textPath href="#wavePath" startOffset="0%">
          4× Avg ROAS &nbsp;✦&nbsp; 1,500+ Ads Produced &nbsp;✦&nbsp; 100+ Brands &nbsp;✦&nbsp; Short-Form UGC &nbsp;✦&nbsp; CGI Product Videos &nbsp;✦&nbsp; Campaign Films &nbsp;✦&nbsp; 48h Turnaround &nbsp;✦&nbsp; D2C Specialists &nbsp;✦&nbsp;
        </textPath>
      </text>

    </g>
  </svg>
</div>

