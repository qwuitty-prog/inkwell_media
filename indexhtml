<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Inkwell Media — Creator-Driven Video That Converts</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet"/>

<style>
/* ═══════════════════════════════════════════
   RESET & CSS VARIABLES
═══════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#ffffff;
  --bg2:#fff8f2;
  --bg3:#fff2e6;
  --bg4:#fde8d0;
  --o:#f47c20;
  --o2:#f9973f;
  --o3:#fbb87a;
  --o-dim:rgba(244,124,32,0.1);
  --o-b:rgba(244,124,32,0.2);
  --o-b2:rgba(244,124,32,0.5);
  --text:#1a1208;
  --text2:#3d2c1a;
  --mu:#9a8070;
  --mu2:#c8b09a;
  --serif:'Playfair Display',Georgia,serif;
  --sans:'Outfit',sans-serif;
  --ease:cubic-bezier(.23,1,.32,1);
  --shadow:0 4px 24px rgba(244,124,32,0.12);
  --shadow2:0 12px 48px rgba(244,124,32,0.18);
  /* Video card max active counts */
  --max-mobile-active:2;
  --max-desktop-active:3;
}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{background:var(--bg);color:var(--text);font-family:var(--sans);line-height:1.65;overflow-x:hidden;-webkit-font-smoothing:antialiased}
::-webkit-scrollbar{width:3px}
::-webkit-scrollbar-thumb{background:var(--o);border-radius:2px}

/* ═══════════════════════════════════════════
   NAV
═══════════════════════════════════════════ */
.nav{
  position:fixed;top:0;left:0;right:0;z-index:200;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 clamp(16px,4vw,56px);
  height:80px;
  background:rgba(255,255,255,0.92);
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid var(--o-b);
  box-shadow:0 2px 20px rgba(244,124,32,0.07);
}
.nav-logo{
  font-family:var(--serif);
  font-size:1.4rem;font-weight:900;
  color:var(--text);text-decoration:none;
  display:flex;align-items:center;gap:8px;
}
.nav-logo span{color:var(--o)}
.nav-cta{
  display:inline-flex;align-items:center;
  font-family:var(--sans);font-weight:600;font-size:0.78rem;
  letter-spacing:0.08em;text-transform:uppercase;
  padding:11px 26px;border-radius:100px;
  background:var(--o);color:#fff;
  border:none;cursor:pointer;text-decoration:none;
  transition:background 0.2s,transform 0.2s,box-shadow 0.2s;
  white-space:nowrap;
  box-shadow:0 4px 20px rgba(244,124,32,0.3);
}
.nav-cta:hover{background:var(--o2);transform:translateY(-2px);box-shadow:0 8px 32px rgba(244,124,32,0.4)}

/* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ */
.hero{
  min-height:100svh;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  text-align:center;
  padding:120px 20px 60px;
  position:relative;overflow:hidden;
  background:linear-gradient(160deg,#fff 0%,#fff8f0 60%,#fdebd5 100%);
}
.hero::before{
  content:'';position:absolute;inset:0;z-index:0;
  background-image:radial-gradient(circle,rgba(244,124,32,0.12) 1.5px,transparent 1.5px);
  background-size:32px 32px;
  mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,black 30%,transparent 100%);
  -webkit-mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,black 30%,transparent 100%);
}
.hero-glow{position:absolute;bottom:-20%;right:-10%;width:min(700px,90vw);height:min(700px,90vw);background:radial-gradient(circle,rgba(244,124,32,0.08) 0%,transparent 65%);pointer-events:none;z-index:0}
.hero-glow2{position:absolute;top:-10%;left:-5%;width:min(500px,70vw);height:min(500px,70vw);background:radial-gradient(circle,rgba(251,184,122,0.1) 0%,transparent 65%);pointer-events:none;z-index:0}
.hero-inner{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center}
.hero-pill{
  display:inline-flex;align-items:center;gap:8px;
  font-size:0.68rem;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;
  color:var(--o);background:var(--o-dim);border:1px solid var(--o-b2);
  padding:7px 18px;border-radius:100px;margin-bottom:26px;
  animation:up 0.8s var(--ease) 0.1s both;
}
.pill-dot{width:6px;height:6px;border-radius:50%;background:var(--o);animation:blink 2s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.25;transform:scale(0.55)}}
.hero h1{
  font-family:var(--serif);
  font-size:clamp(2.8rem,8.5vw,7rem);
  font-weight:900;line-height:1.0;letter-spacing:-0.02em;
  max-width:820px;margin-bottom:20px;color:var(--text);
  animation:up 0.8s var(--ease) 0.2s both;
}
.hero h1 em{font-style:italic;color:var(--o);position:relative;display:inline-block}
.hero h1 em::after{content:'';position:absolute;bottom:-4px;left:0;right:0;height:4px;background:linear-gradient(90deg,transparent,var(--o),transparent);border-radius:2px}
.hero-sub{font-size:clamp(0.95rem,2vw,1.15rem);color:var(--mu);max-width:400px;font-weight:300;margin-bottom:40px;animation:up 0.8s var(--ease) 0.32s both}
.hero-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;animation:up 0.8s var(--ease) 0.44s both}
@keyframes up{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
.hero-stats{
  display:flex;gap:clamp(24px,5vw,56px);
  justify-content:center;flex-wrap:wrap;
  margin-top:52px;padding-top:36px;
  border-top:1px solid var(--o-b);
  animation:up 0.8s var(--ease) 0.6s both;
  position:relative;z-index:1;
}
.hero-stat-num{font-family:var(--serif);font-size:2rem;font-weight:900;color:var(--o);line-height:1}
.hero-stat-label{font-size:0.78rem;color:var(--mu);margin-top:4px;font-weight:400}

/* ═══════════════════════════════════════════
   BUTTONS
═══════════════════════════════════════════ */
.btn{
  display:inline-flex;align-items:center;gap:6px;
  font-family:var(--sans);font-weight:600;font-size:0.82rem;
  letter-spacing:0.07em;text-transform:uppercase;
  padding:13px 30px;border-radius:100px;
  cursor:pointer;border:none;text-decoration:none;
  transition:all 0.25s var(--ease);
}
.btn-p{background:var(--o);color:#fff;box-shadow:0 4px 20px rgba(244,124,32,0.3)}
.btn-p:hover{background:var(--o2);transform:translateY(-2px);box-shadow:0 10px 36px rgba(244,124,32,0.4)}
.btn-g{background:#fff;color:var(--o);border:2px solid var(--o-b2)}
.btn-g:hover{border-color:var(--o);background:var(--o-dim);transform:translateY(-2px)}
.btn-w{background:transparent;color:#fff;border:2px solid rgba(255,255,255,0.4)}
.btn-w:hover{background:rgba(255,255,255,0.15);transform:translateY(-2px)}

/* ═══════════════════════════════════════════
   VIDEO SHOWCASE SECTION
   ─ All Cloudinary URLs use: q_auto,f_auto,w_480
   ─ IntersectionObserver plays/pauses videos
   ─ Fallback: shows poster image if no video
═══════════════════════════════════════════ */
.videos{
  padding:clamp(48px,7vw,90px) 0;
  position:relative;
  background:var(--bg2);
}
.vid-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:0 clamp(16px,4vw,80px);
  margin-bottom:28px;
}
.vid-label{
  font-size:0.66rem;font-weight:600;letter-spacing:0.22em;
  text-transform:uppercase;color:var(--o);
  display:flex;align-items:center;gap:10px;
}
.vid-label::after{content:'';width:28px;height:1px;background:var(--o);opacity:0.5}

/* ── Desktop Grid: 3 cards ── */
.vid-desktop{
  display:none;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
  padding:0 clamp(48px,8vw,120px);
}
@media(min-width:700px){
  .vid-desktop{display:grid}
  .vid-mobile{display:none!important}
}

/* ── Mobile slider ── */
.vid-mobile{display:block;position:relative}
.vid-mobile-outer{
  overflow-x:auto;
  scroll-snap-type:x mandatory;
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;
  padding:0 clamp(16px,4vw,28px);
  display:flex;gap:12px;
}
.vid-mobile-outer::-webkit-scrollbar{display:none}

/* Mobile controls */
.vid-controls{display:flex;gap:8px}
.vid-btn{
  width:38px;height:38px;border-radius:50%;
  border:2px solid var(--o-b2);background:#fff;
  color:var(--o);font-size:1rem;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:background 0.2s,border-color 0.2s,transform 0.2s;
  box-shadow:var(--shadow);
}
.vid-btn:hover{background:var(--o);color:#fff;border-color:var(--o);transform:scale(1.08)}
@media(min-width:700px){.vid-controls{display:none}}

/* Dot indicators */
.vid-dots{display:flex;justify-content:center;gap:8px;margin-top:18px}
.vid-dot{width:8px;height:8px;border-radius:50%;background:var(--o-b2);transition:background 0.2s,transform 0.2s;cursor:pointer}
.vid-dot.active{background:var(--o);transform:scale(1.3)}
@media(min-width:700px){.vid-dots{display:none}}

/* ── Shared Video Card ──
   Uses 9:16 aspect ratio, rounded corners, hover lift.
   Supports "no-video" fallback — if video absent, poster shows. */
.vid-card{
  border-radius:22px;
  overflow:hidden;
  background:#f5ede4;
  border:1px solid var(--o-b);
  position:relative;
  flex-shrink:0;
  box-shadow:var(--shadow);
  transition:transform 0.3s var(--ease),box-shadow 0.3s;
  /* Cursor pointer so it feels interactive */
  cursor:pointer;
}
.vid-card:hover{transform:translateY(-6px);box-shadow:var(--shadow2)}

/* Sizing */
.vid-desktop .vid-card{aspect-ratio:9/16;width:100%}
.vid-mobile .vid-card{
  aspect-ratio:9/16;
  width:calc(50vw - 22px);
  scroll-snap-align:start;
}

/* ── Video element inside card ──
   - object-fit:cover fills the card
   - display:block removes inline gap */
.vid-card video{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  /* Transition for smooth fade-in once loaded */
  opacity:0;
  transition:opacity 0.4s ease;
}
/* Once video has loaded metadata, fade it in */
.vid-card video.loaded{opacity:1}

/* ── Fallback poster layer ──
   Shown when video is absent or loading.
   Background-image set inline via JS or HTML attribute. */
.vid-poster{
  position:absolute;inset:0;
  background-size:cover;
  background-position:center;
  background-color:#f5ede4;
  /* Fade out when video is ready */
  transition:opacity 0.4s ease;
  z-index:1;
}
/* Hide poster once video is loaded */
.vid-card.video-ready .vid-poster{opacity:0;pointer-events:none}

/* ── Gradient overlay ── */
.vid-overlay{
  position:absolute;inset:0;z-index:2;
  background:linear-gradient(180deg,transparent 50%,rgba(20,10,0,0.35) 100%);
  pointer-events:none;
  border-radius:inherit;
}

/* ── Play icon shown when video is paused (optional visual cue) ── */
.vid-play-hint{
  position:absolute;bottom:14px;right:14px;z-index:3;
  width:32px;height:32px;border-radius:50%;
  background:rgba(255,255,255,0.85);
  display:flex;align-items:center;justify-content:center;
  font-size:0.75rem;color:var(--o);
  opacity:0;transition:opacity 0.25s;
  pointer-events:none;
}
.vid-card:not(.video-playing) .vid-play-hint{opacity:0.7}

/* ═══════════════════════════════════════════
   WAVE / ZIG-ZAG MARQUEE TEXT SECTION
   ─ Uses SVG textPath for curved text
   ─ CSS animation drives the loop
   ─ Seamless by duplicating the path content
═══════════════════════════════════════════ */
.wave-marquee{
  width:100%;
  overflow:hidden;
  background:var(--o);
  padding:0;
  position:relative;
  /* Height determined by SVG viewBox */
  line-height:0;
  border-top:1px solid var(--o-b);
  border-bottom:1px solid var(--o-b);
}

/* The SVG itself — full width, auto height via viewBox */
.wave-marquee svg{
  display:block;
  width:100%;
  /* Height scales proportionally */
  height:auto;
  overflow:visible;
}

/* The entire group that moves left */
.wave-group{
  animation:wave-scroll 18s linear infinite;
  will-change:transform;
}

/* On hover, pause the scroll */
.wave-marquee:hover .wave-group{
  animation-play-state:paused;
}

/* Move the group left by exactly half its width (half = one full set of text) */
@keyframes wave-scroll{
  0%  {transform:translateX(0)}
  100%{transform:translateX(-50%)}
}

/* Text styling — bold, spaced, white */
.wave-marquee text{
  font-family:var(--serif);
  font-size:22px;
  font-weight:700;
  fill:#fff;
  letter-spacing:2px;
  font-style:italic;
}

/* ═══════════════════════════════════════════
   STRAIGHT MARQUEE (secondary - orange bar)
═══════════════════════════════════════════ */
.marquee-wrap{
  overflow:hidden;
  padding:14px 0;
  background:var(--text);
}
.marquee-track{display:flex;width:max-content;animation:marquee 22s linear infinite;will-change:transform}
.marquee-item{
  display:inline-flex;align-items:center;gap:14px;
  padding:0 28px;
  font-size:0.68rem;letter-spacing:0.2em;text-transform:uppercase;
  color:rgba(255,255,255,0.6);font-weight:600;white-space:nowrap;
}
.m-dia{width:5px;height:5px;background:var(--o);transform:rotate(45deg);flex-shrink:0}
@keyframes marquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* ═══════════════════════════════════════════
   SECTIONS — shared
═══════════════════════════════════════════ */
section{padding:clamp(60px,8vw,100px) clamp(16px,4vw,56px)}
.container{max-width:1060px;margin:0 auto}
.eyebrow{font-size:0.66rem;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;color:var(--o);display:flex;align-items:center;gap:10px;margin-bottom:12px}
.eyebrow::after{content:'';width:28px;height:1px;background:var(--o);opacity:0.5}
.sec-title{font-family:var(--serif);font-size:clamp(1.9rem,5vw,3.2rem);font-weight:900;line-height:1.07;letter-spacing:-0.02em;margin-bottom:14px;color:var(--text)}
.sec-sub{color:var(--mu);font-size:0.93rem;font-weight:300;max-width:440px;line-height:1.75}

/* ═══════════════════════════════════════════
   SOCIAL PROOF
═══════════════════════════════════════════ */
.proof-section{
  background:var(--bg3);
  padding:clamp(40px,5vw,64px) clamp(16px,4vw,56px);
  border-top:1px solid var(--o-b);
  border-bottom:1px solid var(--o-b);
}
.proof-inner{max-width:1060px;margin:0 auto;display:flex;align-items:center;gap:clamp(24px,5vw,60px);flex-wrap:wrap;justify-content:center}
.proof-img{width:clamp(80px,12vw,140px);height:clamp(80px,12vw,140px);border-radius:20px;overflow:hidden;flex-shrink:0;border:2px solid var(--o-b);box-shadow:var(--shadow)}
.proof-img img{width:100%;height:100%;object-fit:cover;display:block}
.proof-text{flex:1;min-width:220px;max-width:540px}
.proof-quote{font-family:var(--serif);font-size:clamp(1.1rem,2.5vw,1.5rem);font-weight:700;font-style:italic;color:var(--text);line-height:1.4;margin-bottom:14px}
.proof-name{font-size:0.85rem;font-weight:600;color:var(--o)}
.proof-role{font-size:0.78rem;color:var(--mu);margin-top:2px}
.proof-stars{color:var(--o);font-size:0.9rem;margin-bottom:8px;letter-spacing:2px}

/* ═══════════════════════════════════════════
   SERVICES
═══════════════════════════════════════════ */
.services{background:var(--bg)}
.svc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin-top:44px}
.svc-card{
  background:#fff;padding:36px 30px;
  border-radius:20px;border:1px solid var(--o-b);
  position:relative;overflow:hidden;
  transition:transform 0.3s var(--ease),box-shadow 0.3s,border-color 0.3s;
  box-shadow:0 2px 12px rgba(244,124,32,0.07);
}
.svc-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:4px;background:linear-gradient(90deg,transparent,var(--o),transparent);opacity:0;transition:opacity 0.3s}
.svc-card:hover{transform:translateY(-6px);box-shadow:var(--shadow2);border-color:var(--o-b2)}
.svc-card:hover::after{opacity:1}
.svc-num{font-family:var(--serif);font-size:3.8rem;font-weight:900;color:rgba(244,124,32,0.07);line-height:1;margin-bottom:-12px;user-select:none}
.svc-emoji{font-size:1.8rem;margin-bottom:14px;display:block}
.svc-card h3{font-family:var(--serif);font-size:1.35rem;font-weight:700;margin-bottom:9px;color:var(--text)}
.svc-card p{color:var(--mu);font-size:0.88rem;line-height:1.72}

/* ═══════════════════════════════════════════
   VS SECTION
═══════════════════════════════════════════ */
.vs-section{background:var(--bg3)}
.vs-grid{display:grid;grid-template-columns:1fr;border:2px solid var(--o-b2);border-radius:24px;overflow:hidden;margin-top:44px}
@media(min-width:600px){.vs-grid{grid-template-columns:1fr 1fr}}
.vs-col{padding:36px 30px}
.vs-ours{background:linear-gradient(145deg,var(--o) 0%,var(--o2) 100%)}
.vs-them{background:#fff;border-top:1px solid var(--o-b)}
@media(min-width:600px){.vs-them{border-top:none;border-left:2px solid var(--o-b2)}}
.vs-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px}
.vs-name{font-family:var(--serif);font-size:1.15rem;font-weight:700}
.vs-ours .vs-name{color:#fff}.vs-them .vs-name{color:var(--text)}
.vs-badge{font-size:0.66rem;font-weight:700;letter-spacing:0.1em;padding:4px 12px;border-radius:100px}
.vs-ours .vs-badge{background:rgba(255,255,255,0.25);color:#fff}
.vs-them .vs-badge{background:var(--o-dim);color:var(--mu)}
.vs-list{list-style:none;display:flex;flex-direction:column;gap:12px}
.vs-list li{display:flex;align-items:flex-start;gap:10px;font-size:0.9rem;line-height:1.55}
.vi{flex-shrink:0;margin-top:2px;font-size:11px}
.vs-ours li{color:rgba(255,255,255,0.95)}.vs-ours .vi{color:#fff}
.vs-them li{color:var(--mu)}.vs-them .vi{color:var(--mu2)}

/* ═══════════════════════════════════════════
   FEATURES
═══════════════════════════════════════════ */
.features{background:var(--bg)}
.feat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:44px}
.feat-card{
  padding:28px 24px;border:1px solid var(--o-b);
  border-radius:18px;background:#fff;
  transition:transform 0.3s var(--ease),box-shadow 0.3s,border-color 0.3s;
  box-shadow:0 2px 12px rgba(244,124,32,0.06);
}
.feat-card:hover{transform:translateY(-5px);box-shadow:var(--shadow2);border-color:var(--o-b2)}
.feat-icon{width:44px;height:44px;border-radius:12px;background:var(--o-dim);display:flex;align-items:center;justify-content:center;font-size:1.3rem;margin-bottom:14px}
.feat-card h4{font-family:var(--serif);font-size:1.08rem;font-weight:700;margin-bottom:7px;color:var(--text)}
.feat-card p{font-size:0.87rem;color:var(--mu);line-height:1.68}

/* ═══════════════════════════════════════════
   PRICING
═══════════════════════════════════════════ */
.pricing{background:var(--bg2)}
.price-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;margin-top:44px}
.price-card{
  background:#fff;border:2px solid var(--o-b);
  border-radius:22px;padding:32px 28px;
  display:flex;flex-direction:column;gap:22px;
  position:relative;overflow:hidden;
  transition:transform 0.3s var(--ease),box-shadow 0.3s,border-color 0.3s;
  box-shadow:0 2px 16px rgba(244,124,32,0.07);
}
.price-card:hover{transform:translateY(-6px);border-color:var(--o-b2);box-shadow:var(--shadow2)}
.price-card.featured{border-color:var(--o);background:linear-gradient(155deg,#fff6ee,#fff)}
.feat-tag{position:absolute;top:16px;right:-28px;background:var(--o);color:#fff;font-size:0.58rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:5px 44px;transform:rotate(45deg)}
.p-name{font-size:0.7rem;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:var(--o)}
.p-price{font-family:var(--serif);font-size:2.4rem;font-weight:900;line-height:1;color:var(--text)}
.p-period{font-size:0.76rem;color:var(--mu);margin-top:3px}
.p-divider{height:1px;background:var(--o-b)}
