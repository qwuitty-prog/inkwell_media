<script>
/* ═══════════════════════════════════════════
   VIDEO INTERSECTION OBSERVER
   
   HOW IT WORKS:
   1. We select all [data-video-card] elements.
   2. A single IntersectionObserver watches each card.
   3. When a card enters the viewport (threshold: 0.3 = 30% visible),
      we call playVideo(card).
   4. When it exits, we call pauseVideo(card).
   
   ACTIVE LIMIT:
   • We track how many videos are actively playing.
   • Mobile (viewport < 700px): max 2 simultaneous
   • Desktop: max 3 simultaneous
   • If limit reached, we skip playing newly visible cards
     (they'll play when earlier ones pause).
   
   FADE-IN:
   • Once video has loaded metadata, we add class .loaded
     which sets opacity:1 (CSS transition handles the fade).
   • We also add .video-ready to the card to hide the poster layer.
═══════════════════════════════════════════ */
(function() {
  'use strict';

  const isMobile = () => window.innerWidth < 700;
  const maxActive = () => isMobile() ? 2 : 3;

  // Track currently playing videos
  const playing = new Set();

  /**
   * Attempt to play a video inside a card.
   * Respects the active video limit.
   */
  function playVideo(card) {
    const video = card.querySelector('video');
    if (!video) return;

    // Check active limit
    if (playing.size >= maxActive() && !playing.has(card)) return;

    playing.add(card);
    card.classList.add('video-playing');

    // Mark as loaded for fade-in once metadata ready
    if (video.readyState >= 1) {
      video.classList.add('loaded');
      card.classList.add('video-ready');
    } else {
      video.addEventListener('loadedmetadata', () => {
        video.classList.add('loaded');
        card.classList.add('video-ready');
      }, { once: true });
    }

    video.play().catch(() => {
      // Autoplay blocked — poster stays visible, which is fine
      playing.delete(card);
      card.classList.remove('video-playing');
    });
  }

  /**
   * Pause a video and free up the active slot.
   */
  function pauseVideo(card) {
    const video = card.querySelector('video');
    if (!video) return;

    video.pause();
    playing.delete(card);
    card.classList.remove('video-playing');
  }

  // IntersectionObserver: fires when card enters/exits viewport
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        playVideo(entry.target);
      } else {
        pauseVideo(entry.target);
      }
    });
  }, {
    // threshold: 0.3 = card must be 30% visible to trigger play
    threshold: 0.3
  });

  // Observe all video cards
  document.querySelectorAll('[data-video-card]').forEach(card => {
    observer.observe(card);
  });

})();


/* ═══════════════════════════════════════════
   MOBILE VIDEO SLIDER
   Handles: prev/next buttons, dot indicators,
   snap scroll, and seamless loop via clone card.
═══════════════════════════════════════════ */
(function() {
  const outer = document.getElementById('mobOuter');
  if (!outer) return;

  const cards = Array.from(outer.querySelectorAll('.vid-card'));
  const dots  = Array.from(document.querySelectorAll('.vid-dot'));
  const REAL  = 3; // real cards (4th is a clone)
  let cur = 0;

  function cardW() {
    // card width + gap (12px gap defined in CSS)
    return cards[0].offsetWidth + 12;
  }

  function setActiveDot(idx) {
    dots.forEach((d, i) => d.classList.toggle('active', i === idx));
  }

  function goTo(idx, smooth = true) {
    outer.scrollTo({ left: idx * cardW(), behavior: smooth ? 'smooth' : 'instant' });
    cur = idx % REAL;
    setActiveDot(cur);
  }

  // Previous button
  document.getElementById('vidPrev').addEventListener('click', () => {
    goTo(cur <= 0 ? REAL - 1 : cur - 1);
  });

  // Next button — if we reach clone (idx 3), jump back to real idx 0
  document.getElementById('vidNext').addEventListener('click', () => {
    if (cur >= REAL - 1) {
      // Scroll to clone first (smooth), then snap back to real card 0
      outer.scrollTo({ left: 3 * cardW(), behavior: 'smooth' });
      setTimeout(() => { goTo(0, false); }, 350);
      cur = 0;
      setActiveDot(0);
    } else {
      goTo(cur + 1);
    }
  });

  // Update dots on manual finger-scroll
  outer.addEventListener('scroll', () => {
    const idx = Math.round(outer.scrollLeft / cardW()) % REAL;
    setActiveDot(idx);
    cur = idx;
  }, { passive: true });

  // Dot click navigation
  dots.forEach(d => {
    d.addEventListener('click', () => goTo(parseInt(d.dataset.i)));
  });

})();


/* ═══════════════════════════════════════════
   SCROLL REVEAL
   Adds .in class to .reveal elements when
   they enter the viewport (opacity + translateY).
═══════════════════════════════════════════ */
(function() {
  const els = document.querySelectorAll('.reveal');
  if (!('IntersectionObserver' in window)) {
    els.forEach(e => e.classList.add('in'));
    return;
  }
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  els.forEach(el => io.observe(el));
})();
</script>

